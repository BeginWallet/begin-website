{
  "name": "Begin Mono",
  "version": "1.0.0",
  "color": {
    "light": { "bg": "#FFFFFF", "surface": "#F4F4F5", "line": "#ECECEE", "ink": "#0A0A0B", "ink-2": "#6E6E73", "ink-3": "#8E8E93", "ink-soft": "#3A3A3C", "mist": "#E4E4E7", "signal": "#1FD1E5", "alert": "#B42318", "tint-bg": "#DDF6F9", "tint-fg": "#00505A" },
    "dark":  { "bg": "#000000", "surface": "#141416", "line": "#232326", "ink": "#FFFFFF", "ink-2": "#9A9AA0", "ink-3": "#68686D", "mist": "#1C1C1F", "signal": "#1FD1E5", "alert": "#FF7A6B" }
  },
  "font": { "family": "Open Sauce One", "weights": { "light": 300, "regular": 400, "medium": 500, "semibold": 600 } },
  "type": {
    "display":  { "size": 96, "lineHeight": 0.95, "weight": 300, "tracking": "-0.05em" },
    "balance":  { "size": 64, "lineHeight": 1.05, "weight": 300, "tracking": "-0.05em" },
    "heading1": { "size": 48, "lineHeight": 1.05, "weight": 300, "tracking": "-0.04em" },
    "heading2": { "size": 32, "lineHeight": 1.1,  "weight": 300, "tracking": "-0.03em" },
    "title":    { "size": 20, "lineHeight": 1.3,  "weight": 500, "tracking": "-0.02em" },
    "body":     { "size": 16, "lineHeight": 1.55, "weight": 400, "tracking": "0" },
    "label":    { "size": 14, "lineHeight": 1.4,  "weight": 500, "tracking": "0" },
    "caption":  { "size": 12, "lineHeight": 1.4,  "weight": 400, "tracking": "0.01em" }
  },
  "space": [4, 8, 12, 16, 20, 24, 32, 48, 64, 96, 128],
  "radius": { "chip": 12, "input": 16, "tile": 20, "card": 28, "sheet": 40, "button": "pill" },
  "icon": { "grid": 24, "stroke": 1.6, "caps": "round" },
  "motion": {
    "smooth": { "response": 0.45, "dampingFraction": 1.0 },
    "quick":  { "response": 0.35, "dampingFraction": 1.0 }
  }
